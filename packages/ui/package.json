{
  "name": "@nearpay-internal/ui",
  "version": "0.4.0",
  "description": "NearPay design system: tokens, component CSS and thin accessible React 19 components.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    },
    "./icons-svg": {
      "types": "./dist/icons/svg.d.ts",
      "import": "./dist/icons/svg.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./prose.css": "./dist/prose.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "gallery:dev": "vite --config gallery/vite.config.ts",
    "gallery:build": "vite build --config gallery/vite.config.ts"
  },
  "kitBuild": {
    "compilerOptions": {
      "jsx": "react-jsx",
      "types": []
    },
    "copy": [
      "tokens.css",
      "styles.css",
      "fonts.css",
      "prose.css"
    ]
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "5.4.21"
  }
}
