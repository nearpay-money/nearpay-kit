exports[`snapshot and a11y smoke (0.5.0 components) > ConvergenceHero 1`] = `"<figure class="np-convergence" data-motion="off"><svg class="np-convergence__svg" viewBox="0 0 600 560" aria-hidden="true" focusable="false"><defs><linearGradient id="_R_0_-rt" x1="0" x2="1"><stop offset="0" stop-color="#5B5BD6" stop-opacity="0.15"></stop><stop offset="1" stop-color="#8EF0D3"></stop></linearGradient><filter id="_R_0_-glow" x="-200%" y="-200%" width="500%" height="500%"><feGaussianBlur stdDeviation="5" result="b"></feGaussianBlur><feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter></defs><path id="_R_0_-r0" class="np-convergence__route" d="M70 92 C 250 92, 300 300, 452 300" fill="none" stroke="url(#_R_0_-rt)" stroke-width="2.5"></path><path id="_R_0_-r1" class="np-convergence__route" d="M70 196 C 260 196, 290 300, 452 300" fill="none" stroke="url(#_R_0_-rt)" stroke-width="2.5"></path><path id="_R_0_-r2" class="np-convergence__route" d="M70 300 L 452 300" fill="none" stroke="url(#_R_0_-rt)" stroke-width="2.5"></path><path id="_R_0_-r3" class="np-convergence__route" d="M70 404 C 260 404, 290 300, 452 300" fill="none" stroke="url(#_R_0_-rt)" stroke-width="2.5"></path><path id="_R_0_-r4" class="np-convergence__route" d="M70 508 C 250 508, 300 300, 452 300" fill="none" stroke="url(#_R_0_-rt)" stroke-width="2.5"></path><circle class="np-convergence__dot" r="5" fill="#E9FFF8" filter="url(#_R_0_-glow)" opacity="0"><animateMotion begin="indefinite" dur="1.5s" calcMode="spline" keyTimes="0;1" keySplines="0.45 0 0.2 1" fill="remove"><mpath href="#_R_0_-r0"></mpath></animateMotion><animate attributeName="opacity" begin="indefinite" dur="1.5s" values="0;1;1;0" keyTimes="0;0.1;0.92;1" fill="remove"></animate></circle><circle class="np-convergence__dot" r="5" fill="#E9FFF8" filter="url(#_R_0_-glow)" opacity="0"><animateMotion begin="indefinite" dur="1.5s" calcMode="spline" keyTimes="0;1" keySplines="0.45 0 0.2 1" fill="remove"><mpath href="#_R_0_-r1"></mpath></animateMotion><animate attributeName="opacity" begin="indefinite" dur="1.5s" values="0;1;1;0" keyTimes="0;0.1;0.92;1" fill="remove"></animate></circle><circle class="np-convergence__dot" r="5" fill="#E9FFF8" filter="url(#_R_0_-glow)" opacity="0"><animateMotion begin="indefinite" dur="1.5s" calcMode="spline" keyTimes="0;1" keySplines="0.45 0 0.2 1" fill="remove"><mpath href="#_R_0_-r2"></mpath></animateMotion><animate attributeName="opacity" begin="indefinite" dur="1.5s" values="0;1;1;0" keyTimes="0;0.1;0.92;1" fill="remove"></animate></circle><circle class="np-convergence__dot" r="5" fill="#E9FFF8" filter="url(#_R_0_-glow)" opacity="0"><animateMotion begin="indefinite" dur="1.5s" calcMode="spline" keyTimes="0;1" keySplines="0.45 0 0.2 1" fill="remove"><mpath href="#_R_0_-r3"></mpath></animateMotion><animate attributeName="opacity" begin="indefinite" dur="1.5s" values="0;1;1;0" keyTimes="0;0.1;0.92;1" fill="remove"></animate></circle><circle class="np-convergence__dot" r="5" fill="#E9FFF8" filter="url(#_R_0_-glow)" opacity="0"><animateMotion begin="indefinite" dur="1.5s" calcMode="spline" keyTimes="0;1" keySplines="0.45 0 0.2 1" fill="remove"><mpath href="#_R_0_-r4"></mpath></animateMotion><animate attributeName="opacity" begin="indefinite" dur="1.5s" values="0;1;1;0" keyTimes="0;0.1;0.92;1" fill="remove"></animate></circle><circle cx="452" cy="300" r="22" fill="none" stroke="#8EF0D3" stroke-opacity="0.35" stroke-width="2"></circle><circle class="np-convergence__pulse" cx="452" cy="300" r="22" fill="none" stroke="#8EF0D3" stroke-width="2" opacity="0"><animate attributeName="r" begin="indefinite" dur="0.7s" values="12;40" fill="remove"></animate><animate attributeName="opacity" begin="indefinite" dur="0.7s" values="0.9;0" fill="remove"></animate></circle><circle cx="452" cy="300" r="10" fill="#8EF0D3" filter="url(#_R_0_-glow)"><animate attributeName="r" begin="indefinite" dur="0.5s" values="10;14;10" fill="remove"></animate></circle></svg><