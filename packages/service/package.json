{
  "name": "@nearpay-internal/service",
  "version": "0.3.1",
  "description": "Service bootstrap: Fastify routes from spec definitions, internal-token auth, request context, error envelopes, idempotency hook, SSE, health/readiness, Prometheus metrics, tracing, pino, config/secrets, graceful shutdown, process runner.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@nearpay-internal/auth": "workspace:*",
    "@nearpay-internal/http": "workspace:*",
    "@nearpay-internal/ids": "workspace:*",
    "@nearpay/spec": "0.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "fastify": "5.12.8",
    "pino": "9.14.0",
    "prom-client": "15.1.3"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nearpay-internal/spec": "0.3.0",
    "zod": "4.6.7"
  }
}
